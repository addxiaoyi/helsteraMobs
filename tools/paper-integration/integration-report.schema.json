{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://helstera.dev/schemas/paper-integration-report-v1.json",
  "title": "Helstera Paper Integration Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAtUtc",
    "fixtureDirectory",
    "evidenceMode",
    "paperVersion",
    "paperApiVersion",
    "pluginEnabled",
    "log",
    "expectedProbeIds",
    "probes"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAtUtc": { "type": "string", "format": "date-time" },
    "fixtureDirectory": { "type": "string", "minLength": 1 },
    "evidenceMode": { "enum": ["release", "exploratory"] },
    "paperVersion": { "type": ["string", "null"] },
    "paperApiVersion": { "type": ["string", "null"] },
    "pluginEnabled": { "type": "boolean" },
    "runnerSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "conditionProbeSourceSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "dispatchProbeSourceSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "comparisonProbeSourceSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "variablePlaceholderProbeSourceSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "triggerPlaceholderProbeSourceSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "fixtureProbeSourceSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "fixtureProbeJarSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "naturalSpawnClientSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "randomSpawnConfigSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "mythicMobCatalogSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "nativeMobConfigSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "replacementMobConfigSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "conditionGuardMobConfigSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "sharedSourceSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "pluginSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "paperJarSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "externalPlugin": { "type": "string", "minLength": 1 },
    "externalPluginSource": { "type": "string", "format": "uri" },
    "externalPluginLicense": { "type": "string", "minLength": 1 },
    "externalPluginSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "externalPluginSha512": { "type": "string", "pattern": "^[0-9a-f]{128}$" },
    "log": { "type": "string", "minLength": 1 },
    "expectedProbeIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "probes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "observations"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "status": {
            "enum": [
              "passed",
              "failed",
              "observed-rejected",
              "observed",
              "insufficient-sample",
              "not-observed"
            ]
          },
          "observations": {
            "type": "array",
            "items": { "type": "string" }
          },
          "sampleCount": { "type": "integer", "minimum": 0 },
          "expected": { "type": "string" },
          "observed": { "type": "string" },
          "deviation": { "type": "string" }
          ,"maxDeviation": { "type": "number", "minimum": 0, "maximum": 1 }
          ,"tolerance": { "type": "number", "minimum": 0, "maximum": 1 }
          ,"before": { "type": "string" }
          ,"after": { "type": "string" }
          ,"offsetDistance": { "type": "number", "minimum": 0 }
          ,"movedDistance": { "type": "number", "minimum": 0 }
        },
        "allOf": [
          {
            "if": {
              "properties": { "id": { "const": "random-spawn-distribution" } },
              "required": ["id"]
            },
            "then": {
              "required": ["sampleCount", "expected", "observed", "deviation",
                "maxDeviation", "tolerance"]
            }
          }
        ]
      }
    }
  }
}
