<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>dev.helstera</groupId>
        <artifactId>helstera-parent</artifactId>
        <version>1.0.0</version>
    </parent>
    <artifactId>helstera-plugin</artifactId>
    <name>helstera-plugin</name>

    <dependencies>
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.joml</groupId>
            <artifactId>joml</artifactId>
            <version>1.10.5</version>
        </dependency>
        <!--
            全部 helstera 模块在基础段以 provided 作用域声明：只进编译期类路径，不进 uber jar。

            这样做的原因：HelsteraPlugin / HelsteraCommand 直接 import 了 web、platform、
            integrations、migration 的类型（用于类型安全的局部变量与优雅降级），
            若这些模块不进编译类路径，任何 -P phaseN 构建都会在 compile 期报
            "找不到符号"，分阶段出包根本产不出来。

            shade 只打包 compile/runtime 作用域，因此 provided 的模块不会被并进 jar；
            实际打进哪些模块由下方 profile 决定。运行期缺失由 onEnable 里的
            try/catch NoClassDefFoundError 降级处理。
        -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency><groupId>dev.helstera</groupId><artifactId>helstera-api</artifactId><scope>provided</scope></dependency>
        <dependency><groupId>dev.helstera</groupId><artifactId>helstera-core</artifactId><scope>provided</scope></dependency>
        <dependency><groupId>dev.helstera</groupId><artifactId>helstera-runtime</artifactId><scope>provided</scope></dependency>
        <dependency><groupId>dev.helstera</groupId><artifactId>helstera-render-paper</artifactId><scope>provided</scope></dependency>
        <dependency><groupId>dev.helstera</groupId><artifactId>helstera-resourcepack</artifactId><scope>provided</scope></dependency>
        <dependency><groupId>dev.helstera</groupId><artifactId>helstera-ai</artifactId><scope>provided</scope></dependency>
        <dependency><groupId>dev.helstera</groupId><artifactId>helstera-integrations</artifactId><scope>provided</scope></dependency>
        <dependency><groupId>dev.helstera</groupId><artifactId>helstera-web</artifactId><scope>provided</scope></dependency>
        <dependency><groupId>dev.helstera</groupId><artifactId>helstera-migration</artifactId><scope>provided</scope></dependency>
        <dependency><groupId>dev.helstera</groupId><artifactId>helstera-platform</artifactId><scope>provided</scope></dependency>
    </dependencies>

    <properties>
        <!-- 每个 profile 覆盖 build.variant，产出互不覆盖的 jar。
             此前所有 profile 共用 finalName=helsteraMobs-${project.version}，
             phase 构建会静默覆盖完整版产物：按 phase 验证完再部署，
             拿到的却是上一轮 phase 的残缺 jar（实测 1.03MB、缺 web 模块）。 -->
        <build.variant>full</build.variant>
    </properties>

    <build>
        <!-- full 保持 helsteraMobs-${project.version} 原名，避免影响既有发布流程 -->
        <finalName>helsteraMobs-${project.version}-${build.variant}</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!--
        分阶段出包：每个 phase profile 只"声明"该阶段已完成的 helstera 模块依赖，
        shade 插件把【实际声明的依赖】全部打进 uber jar，因而天然产出由少到多的递增能力 jar，
        不依赖 shade 过滤器合并（之前的合并方式在 .m2 重装后不稳定）。
        默认构建（不激活任何 -P）= full（activeByDefault）= 完整版 5.0。
        注意：一旦用 -P 显式指定任一 profile，activeByDefault 的 full 会自动关闭。
    -->
    <profiles>
        <!-- full / 5.0：完整版（默认激活） -->
        <profile>
            <id>full</id>
            <properties>
                <build.variant>full</build.variant>
            </properties>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <dependencies>
                <dependency><groupId>dev.helstera</groupId><artifactId>helstera-api</artifactId></dependency>
                <dependency><groupId>dev.helstera</groupId><artifactId>helstera-core</artifactId></dependency>
                <dependency><groupId>dev.helstera</groupId><artifactId>helstera-runtime</artifactId></dependency>
                <dependency><groupId>dev.helstera</groupId><artifactId>helstera-render-paper</artifactId></dependency>
                <dependency><groupId>dev.helstera</groupId><artifactId>helstera-resourcepack</artifactId></dependency>
                <dependency><groupId>dev.helstera</groupId><artifactId>helstera-ai</artifactId></dependency>
                <dependency><groupId>dev.helstera</groupId><artifactId>helstera-integrations</artifactId></dependency>
                <dependency><groupId>dev.helstera</groupId><artifactId>helstera-web</artifactId></dependency>
                <dependency><groupId>dev.helstera</groupId><artifactId>helstera-migration</artifactId></dependency>
                <dependency><groupId>dev.helstera</groupId><artifactId>helstera-platform</artifactId></dependency>
            </dependencies>
        </profile>

        <!-- 1.0：仅核心（api + core）：模型解析/校验/注册表/命令 -->
        <profile>
            <id>phase1</id>
            <properties>
                <build.variant>phase1</build.variant>
            </properties>
            <dependencies>
                <dependency><groupId>dev.helstera</groupId><artifactId>helstera-api</artifactId></dependency>
                <dependency><groupId>dev.helstera</groupId><artifactId>helstera-core</artifactId></dependency>
            </dependencies>
        </profile>

        <!-- 2.0：+ runtime + render-paper：实例渲染 + 动画 + 玩家可见性 -->
        <profile>
            <id>phase2</id>
            <properties>
                <build.variant>phase2</build.variant>
            </properties>
            <dependencies>
                <dependency><groupId>dev.helstera</groupId><artifactId>helstera-api</artifactId></dependency>
                <dependency><groupId>dev.helstera</groupId><artifactId>helstera-core</artifactId></dependency>
                <dependency><groupId>dev.helstera</groupId><artifactId>helstera-runtime</artifactId></dependency>
                <dependency><groupId>dev.helstera</groupId><artifactId>helstera-render-paper</artifactId></dependency>
            </dependencies>
        </profile>

        <!-- 3.0：+ resourcepack + ai：资源包构建 + AI 行为 -->
        <profile>
            <id>phase3</id>
            <properties>
                <build.variant>phase3</build.variant>
            </properties>
            <dependencies>
                <dependency><groupId>dev.helstera</groupId><artifactId>helstera-api</artifactId></dependency>
                <dependency><groupId>dev.helstera</groupId><artifactId>helstera-core</artifactId></dependency>
                <dependency><groupId>dev.helstera</groupId><artifactId>helstera-runtime</artifactId></dependency>
                <dependency><groupId>dev.helstera</groupId><artifactId>helstera-render-paper</artifactId></dependency>
                <dependency><groupId>dev.helstera</groupId><artifactId>helstera-resourcepack</artifactId></dependency>
                <dependency><groupId>dev.helstera</groupId><artifactId>helstera-ai</artifactId></dependency>
            </dependencies>
        </profile>

        <!-- 4.0：+ integrations + migration：外部插件适配 + 迁移中心 -->
        <profile>
            <id>phase4</id>
            <properties>
                <build.variant>phase4</build.variant>
            </properties>
            <dependencies>
                <dependency><groupId>dev.helstera</groupId><artifactId>helstera-api</artifactId></dependency>
                <dependency><groupId>dev.helstera</groupId><artifactId>helstera-core</artifactId></dependency>
                <dependency><groupId>dev.helstera</groupId><artifactId>helstera-runtime</artifactId></dependency>
                <dependency><groupId>dev.helstera</groupId><artifactId>helstera-render-paper</artifactId></dependency>
                <dependency><groupId>dev.helstera</groupId><artifactId>helstera-resourcepack</artifactId></dependency>
                <dependency><groupId>dev.helstera</groupId><artifactId>helstera-ai</artifactId></dependency>
                <dependency><groupId>dev.helstera</groupId><artifactId>helstera-integrations</artifactId></dependency>
                <dependency><groupId>dev.helstera</groupId><artifactId>helstera-migration</artifactId></dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
