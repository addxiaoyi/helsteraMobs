<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.helstera</groupId>
    <artifactId>helstera-parent</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>helsteraMobs Parent</name>

    <modules>
        <module>helstera-api</module>
        <module>helstera-core</module>
        <module>helstera-runtime</module>
        <module>helstera-render-paper</module>
        <module>helstera-resourcepack</module>
        <module>helstera-ai</module>
        <module>helstera-integrations</module>
        <module>helstera-web</module>
        <module>helstera-migration</module>
        <module>helstera-platform</module>
        <module>helstera-plugin</module>
    </modules>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <paper.version>1.21.1-R0.1-SNAPSHOT</paper.version>
        <junit.version>5.11.4</junit.version>
    </properties>

    <!--
      paper-api 不发布到 Maven Central，必须显式声明 PaperMC 仓库，
      否则干净环境下构建会因依赖无法解析而失败。
    -->
    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
    </repositories>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.papermc.paper</groupId>
                <artifactId>paper-api</artifactId>
                <version>${paper.version}</version>
                <scope>provided</scope>
            </dependency>
            <dependency>
                <groupId>dev.helstera</groupId>
                <artifactId>helstera-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.helstera</groupId>
                <artifactId>helstera-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.helstera</groupId>
                <artifactId>helstera-runtime</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.helstera</groupId>
                <artifactId>helstera-render-paper</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.helstera</groupId>
                <artifactId>helstera-resourcepack</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.helstera</groupId>
                <artifactId>helstera-ai</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.helstera</groupId>
                <artifactId>helstera-integrations</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.helstera</groupId>
                <artifactId>helstera-web</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.helstera</groupId>
                <artifactId>helstera-migration</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.helstera</groupId>
                <artifactId>helstera-platform</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- 测试栈：纯离线可用，供各模块在 src/test/java 下补单测 -->
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter-api</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter-engine</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter-params</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <!--
                            开启编译器自带的全部 lint。

                            本项目此前**没有任何**静态分析环节：无 SpotBugs / Checkstyle /
                            PMD / ErrorProne，编译器也未开 -Xlint。javac 不检查的
                            那一类（未使用 import、未使用变量、冗余类型、潜在空指针）
                            只有 IDEA 的 inspection 看得见，CI 与本地构建全都漏掉——
                            IDEA 面板里长期挂着 160+ 个问题就是这么来的。

                            为什么选 -Xlint 而不是 SpotBugs：
                            -Xlint 随 JDK 自带，零依赖、零下载。本机 JDK 的网络栈
                            连不上 repo.maven.apache.org（PowerShell 能通、java.exe
                            超时），引入外部插件需要先解决这个环境问题。
                            SpotBugs 能力强得多（能做数据流与空指针分析），
                            等网络可用后建议再叠加一层。

                            刻意**不加** -Werror：本项目大量使用 Bukkit API 与
                            反射，JDK 升级时可能冒出新警告。让警告可见但不阻断
                            构建，比因为一条 deprecation 就卡住发布更实际。

                            当前基线（2026-10-08，Paper 1.21.1-133）：
                            源码警告 73 条，其中
                              68 条是 Paper 标记的 removal API
                                  （Damageable.getMaxHealth / ChatColor /
                                   Plugin.getConfig / Player.setResourcePack 等）
                              4 条是文本块在参数位置的 javac 误报
                              1 条是 whenComplete 的签名（正常 API 用法）
                            本项目自身的告警已清零。这 68 条**刻意不清**：
                            替换成新 API 需要反射 + 版本分支，风险远大于收益；
                            而 Paper 的 removal 清单在 1.21 仍是「将来」，
                            真要移除时集中迁移一次即可。若将来看到
                            「警告数突然远超 73」，说明引入了新问题。
                        -->
                        <compilerArgs>
                            <arg>-Xlint:all</arg>
                        </compilerArgs>
                        <showWarnings>true</showWarnings>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.2</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
